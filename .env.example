# ---- server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Used to sign the anonymous visitor cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-in-production-please-32-chars-min
# Salt for hashing visitor IPs before storing them.
IP_HASH_SALT=change-me-too

# ---- data stores ----
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot?schema=public
REDIS_URL=redis://localhost:6379

# ---- agent service: MUST Academic Assistant ----
# See MUST_Academic_Assistant_Website_API_Handoff_V1.md ("Stable Contract") for
# the authoritative contract.
# "mock"        -> deterministic local fake, no network (default in dev/test)
# "http"        -> POST {AGENT_BASE_URL}/chat, one JSON reply, chunked for the client
# "http-stream" -> speculative; flip only once the agent team confirms a streaming shape
AGENT_MODE=mock
# Base URL only — no /chat suffix. httpAgent.ts appends /chat, /session/{id}, /health.
# Documented production URL:
AGENT_BASE_URL=https://must-academic-assistant-backend.onrender.com
AGENT_API_KEY=
AGENT_TIMEOUT_MS=120000

# How the non-streaming agent reply is re-emitted so the UI still feels live.
AGENT_FAKE_CHUNK_CHARS=40
AGENT_FAKE_CHUNK_DELAY_MS=25

# ---- conversation limits ----
MAX_MESSAGE_CHARS=8000
MAX_MESSAGES_PER_CONVERSATION=200

# ---- streaming ----
STREAM_TTL_SECONDS=3600
SSE_HEARTBEAT_MS=15000

# ---- rate limits ----
RATE_LIMIT_MESSAGES_PER_MINUTE=12
RATE_LIMIT_CONVERSATIONS_PER_HOUR=30
