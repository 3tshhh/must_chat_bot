# ---- server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Used to sign the anonymous visitor cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-in-production-please-32-chars-min
# Salt for hashing visitor IPs before storing them.
IP_HASH_SALT=change-me-too

# ---- data stores ----
# Local Postgres:
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot?schema=public
# DIRECT_URL is only needed when DATABASE_URL points at a pooler; leave both
# blank for a plain local/direct Postgres.
#
# On Supabase, use the SESSION pooler (port 5432) for DATABASE_URL, not the
# transaction pooler (6543) — this app is a long-running server with its own
# connection pool, and the transaction pooler hands consecutive queries to
# different backend connections mid-request ("prepared statement sN does not
# exist"). ALSO always add pgbouncer=true against Supavisor (either pooling
# mode) — it can still recycle the underlying physical connection across
# separate client sessions, so a leftover prepared statement name can collide
# with a new one ("prepared statement sN already exists"). pgbouncer=true stops
# Prisma from using named prepared statements at all, fixing both directions.
# connection_limit keeps this server's pool well under the pooler's slot cap.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5
#   DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# DIRECT_URL=
REDIS_URL=redis://localhost:6379

# ---- agent service: MUST Academic Assistant ----
# See MUST_Academic_Assistant_Website_API_Handoff_V1.md ("Stable Contract") for
# the authoritative contract.
# "mock"        -> deterministic local fake, no network (default in dev/test)
# "http"        -> POST {AGENT_BASE_URL}/chat, one JSON reply, chunked for the client
# "http-stream" -> speculative; flip only once the agent team confirms a streaming shape
AGENT_MODE=mock
# Base URL only — no /chat suffix. httpAgent.ts appends /chat, /session/{id}, /health.
# Documented production URL:
AGENT_BASE_URL=https://must-academic-assistant-backend.onrender.com
AGENT_API_KEY=
AGENT_TIMEOUT_MS=120000

# How the non-streaming agent reply is re-emitted so the UI still feels live.
AGENT_FAKE_CHUNK_CHARS=40
AGENT_FAKE_CHUNK_DELAY_MS=25

# ---- conversation limits ----
MAX_MESSAGE_CHARS=8000
MAX_MESSAGES_PER_CONVERSATION=200

# ---- streaming ----
STREAM_TTL_SECONDS=3600
SSE_HEARTBEAT_MS=15000

# ---- rate limits ----
RATE_LIMIT_MESSAGES_PER_MINUTE=12
RATE_LIMIT_CONVERSATIONS_PER_HOUR=30
